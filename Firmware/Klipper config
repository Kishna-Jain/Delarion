#This file has not been tested, its still work in progress!




# PIN MAP (from PCB nets)
#   Driver1  STEP GPIO1   DIR GPIO2     -> stepper_x
#   Driver2  STEP GPIO4   DIR GPIO3     -> stepper_y
#   UDriver1 STEP GPIO6   DIR GPIO5     -> stepper_z
#   Endstops X GPIO35 | Y GPIO36 | Z GPIO37   (3-pin: 5V / signal / GND)
#   Q1 gate  GPIO7  -> Fan1 (24V, switched)
#   Q2 gate  GPIO8, Q3 gate GPIO9       (drains not connected to an output)
#   RGB LEDs (SK6805) GPIO11 / GPIO12 / GPIO13
#   Accelerometer footprint: SDA GPIO14, SCL GPIO15 (I2C)



[stepper_x]
step_pin: PF0
dir_pin: PF1
enable_pin: !PD7
microsteps: 16
rotation_distance: 40
endstop_pin: ^PE5
position_endstop: 0
position_max: 200
homing_speed: 50
ax_velocity: 100
max_accel: 1000
max_z_velocity: 8
max_z_accel: 50

[stepper_y]
step_pin: PF6
dir_pin: PF7
enable_pin: !PF2
microsteps: 16
rotation_distance: 40
endstop_pin: ^PJ1
position_endstop: 0
position_max: 200
homing_speed: 50

[stepper_z]
step_pin: PL3
dir_pin: PL1
enable_pin: !PK0
microsteps: 16
rotation_distance: 8
endstop_pin: ^PD3
position_endstop: 0.5
position_max: 200

[extruder]
step_pin: PA4
dir_pin: PA6
enable_pin: !PA2
microsteps: 16
rotation_distance: 33.500
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: PB4
sensor_type: ATC Semitec 104GT-2
sensor_pin: PK5
control: pid
pid_Kp: 22.2
pid_Ki: 1.08
pid_Kd: 114
min_temp: 0
max_temp: 250

[heater_bed]
heater_pin: PH5
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PK6
control: watermark
min_temp: 0
max_temp: 130

[fan]
pin: PH6

[mcu]
serial: /dev/ttyACM0

[printer]
kinematics: corexy
max_velocity: 300
max_accel: 3000
max_z_velocity: 25
max_z_accel: 30

[neopixel led1]
pin: gpio11
chain_count: 1
color_order: GRB

[neopixel led2]
in: gpio12
chain_count: 1
color_order: GRB

[neopixel led3]
pin: gpio13
chain_count: 1
color_order: GRB


